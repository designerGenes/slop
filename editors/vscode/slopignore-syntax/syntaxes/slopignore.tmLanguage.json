{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SlopIgnore",
  "scopeName": "source.slopignore",
  "patterns": [
    {
      "include": "#slopheap"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#slopinclude"
    }
  ],
  "repository": {
    "slopheap": {
      "patterns": [
        {
          "match": "^(\\s*)(\\\\/)(?:\\s+.*)?$",
          "name": "string.quoted.other.slopheap",
          "captures": {
            "2": {
              "name": "string.quoted.other.slopheap"
            }
          }
        },
        {
          "match": "^(\\s*)(/\\\\)\\s*$",
          "name": "string.quoted.other.slopheap",
          "captures": {
            "2": {
              "name": "string.quoted.other.slopheap"
            }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "match": "^\\s*#.*$",
          "name": "comment.line.number-sign.slopignore"
        }
      ]
    },
    "slopinclude": {
      "patterns": [
        {
          "match": "^(\\s*)(slopinclude)\\b",
          "captures": {
            "2": {
              "name": "keyword.control.slopinclude"
            }
          }
        },
        {
          "match": "^(\\s*)(\\+)",
          "captures": {
            "2": {
              "name": "keyword.control.slopinclude"
            }
          }
        }
      ]
    }
  }
}
