{
  "name": "slopignore-syntax",
  "displayName": "SlopIgnore Syntax",
  "description": "Syntax highlighting for SlopIgnore and SlopHeap directives.",
  "version": "0.1.3",
  "publisher": "slop",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "keyword.control.slopinclude",
              "keyword.control.slopheap"
            ],
            "settings": {
              "foreground": "#FFD700"
            }
          }
        ]
      }
    },
    "languages": [
      {
        "id": "slopignore",
        "aliases": [
          "SlopIgnore",
          "slopignore"
        ],
        "filenames": [
          ".slopignore"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "slopignore",
        "scopeName": "source.slopignore",
        "path": "./syntaxes/slopignore.tmLanguage.json"
      }
    ]
  }
}
